# Salin ke .env lalu sesuaikan:  cp .env.example .env
# Semua baris bersifat opsional; nilai di bawah adalah bawaan.

# Domain alamat (pisahkan dengan koma kalau lebih dari satu; tiap domain butuh MX ke server ini)
DOMAINS=venbeemail.com
TTL_MINUTES=60
RANDOM_LENGTH=10
SUFFIX_LENGTH=6
MAX_MESSAGE_BYTES=20971520
NEW_ADDRESS_LIMIT=20
SENDING_ENABLED=false

# HTTP: hanya untuk Nginx aaPanel di mesin yang sama
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
TRUST_PROXY=true

# SMTP masuk
SMTP_HOST=0.0.0.0
SMTP_PORT=25
SMTP_HOSTNAME=mail.venbeemail.com
AUTH_CHECKS=true

# STARTTLS (disarankan). Sertifikat Let's Encrypt dari aaPanel biasanya ada di sini:
# TLS_CERT=/www/server/panel/vhost/cert/venbeemail.com/fullchain.pem
# TLS_KEY=/www/server/panel/vhost/cert/venbeemail.com/privkey.pem

# Lokasi data (bawaan: server/data/banamail.db) dan halaman (bawaan: public/banamail)
# DB_PATH=/www/wwwroot/venbeemail/server/data/banamail.db
# STATIC_DIR=/www/wwwroot/venbeemail/public/banamail

{
  "name": "banamail-worker",
  "version": "1.0.0",
  "private": true,
  "description": "BanaMail backend: receives mail for *@venbeemail.com (Cloudflare Email Routing), stores it in D1 + R2, serves the page and the /api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply banamail --local",
    "db:migrate": "wrangler d1 migrations apply banamail --remote",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "postal-mime": "^4.0.4"
  },
  "devDependencies": {
    "wrangler": "^4.147.0"
  }
}

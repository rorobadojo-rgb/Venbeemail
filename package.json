{
  "name": "venbeemail",
  "version": "1.0.0",
  "private": true,
  "description": "VenbeeMail — zombie mini-market landing page for a disposable email service",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "assets:logo": "python3 scripts/logo/trace_logo.py && node --experimental-strip-types --no-warnings scripts/logo/build-icons.mjs",
    "assets:posters": "node scripts/posters/build-posters.mjs",
    "assets:audio": "node scripts/audio/build-audio.mjs",
    "build:pages": "GITHUB_PAGES=true NEXT_PUBLIC_BASE_PATH=/Venbeemail next build"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/fiber": "^9.8.1",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3"
  }
}
